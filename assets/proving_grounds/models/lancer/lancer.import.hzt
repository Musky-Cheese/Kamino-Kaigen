  material "Emit_Lens"
  shader "/shaders/proving_grounds/gr_surface.glsl"

  material "Emit_Cell"
  shader "/shaders/proving_grounds/gr_surface.glsl"

  material "Emit_Vents"
  shader "/shaders/proving_grounds/gr_surface.glsl"
pass_override 0
